{
  "name": "prc",
  "private": true,
  "description": "Personal Remote Control System: private, self-hosted remote control for a Mac Mini.",
  "workspaces": [
    "packages/protocol",
    "tools/web-harness",
    "tools/e2e"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "harness": "node tools/web-harness/serve.js",
    "e2e": "node tools/e2e/run.ts",
    "android-frames": "node tools/e2e/validate-android-frames.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
