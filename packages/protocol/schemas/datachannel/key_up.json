{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prc.local/schemas/datachannel/key_up.json",
  "type": "object",
  "required": ["v", "type", "ts", "code", "modifiers"],
  "properties": {
    "v": { "$ref": "https://prc.local/schemas/common.json#/$defs/protocolVersion" },
    "type": { "const": "key_up" },
    "ts": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "code": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9]+$" },
    "modifiers": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "type": "string", "enum": ["shift", "control", "alt", "meta", "capslock"] }
    }
  }
}
