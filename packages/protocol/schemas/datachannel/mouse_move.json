{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prc.local/schemas/datachannel/mouse_move.json",
  "type": "object",
  "required": ["v", "type", "ts", "display_id", "x", "y"],
  "properties": {
    "v": { "$ref": "https://prc.local/schemas/common.json#/$defs/protocolVersion" },
    "type": { "const": "mouse_move" },
    "ts": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "display_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "x": { "type": "number", "minimum": 0, "maximum": 1 },
    "y": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
