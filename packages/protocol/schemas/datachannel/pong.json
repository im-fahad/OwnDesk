{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owndesk.local/schemas/datachannel/pong.json",
  "type": "object",
  "required": ["v", "type", "ts", "nonce"],
  "properties": {
    "v": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/protocolVersion" },
    "type": { "const": "pong" },
    "ts": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nonce": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
  }
}
