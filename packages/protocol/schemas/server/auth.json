{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owndesk.local/schemas/server/auth.json",
  "type": "object",
  "required": ["kind", "device_id", "public_key", "role", "sig"],
  "properties": {
    "kind": { "const": "auth" },
    "device_id": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/deviceId" },
    "public_key": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/publicKey" },
    "role": { "type": "string", "enum": ["host", "controller"] },
    "sig": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/signature" }
  }
}
