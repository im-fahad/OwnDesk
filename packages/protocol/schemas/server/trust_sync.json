{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owndesk.local/schemas/server/trust_sync.json",
  "type": "object",
  "required": ["kind", "controllers"],
  "properties": {
    "kind": { "const": "trust_sync" },
    "controllers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["device_id", "public_key", "name"],
        "properties": {
          "device_id": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/deviceId" },
          "public_key": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/publicKey" },
          "name": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/deviceName" }
        }
      }
    }
  }
}
