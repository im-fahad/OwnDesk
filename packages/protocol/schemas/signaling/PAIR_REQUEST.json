{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owndesk.local/schemas/signaling/PAIR_REQUEST.json",
  "type": "object",
  "required": ["public_key", "device_name", "device_type", "pairing_session_id", "proof"],
  "properties": {
    "public_key": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/publicKey" },
    "device_name": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/deviceName" },
    "device_type": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/deviceType" },
    "pairing_session_id": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/bytes16" },
    "proof": { "$ref": "https://owndesk.local/schemas/common.json#/$defs/bytes32" }
  }
}
